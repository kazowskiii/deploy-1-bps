# Salin file ini menjadi ".env" lalu isi nilainya masing-masing.

PORT=3000
SESSION_SECRET=ganti-dengan-teks-acak-yang-rahasia

# --- Konfigurasi OneDrive (Microsoft Graph API) ---
# Untuk akun Microsoft PRIBADI (mis. bpskka@gmail.com / Microsoft 365 Family).
# Diambil dari Azure Portal > Microsoft Entra ID > App registrations > (app Anda)
AZURE_CLIENT_ID=isi-application-client-id-di-sini
AZURE_CLIENT_SECRET=isi-client-secret-di-sini

# Harus SAMA PERSIS dengan Redirect URI yang didaftarkan di Azure Portal
# (App registration > Authentication > Platform: Web > Redirect URIs)
AZURE_REDIRECT_URI=http://localhost:3000/auth/redirect

# (opsional) nama folder tujuan di OneDrive, default: SIMORA-Uploads
ONEDRIVE_FOLDER=SIMORA-Uploads

# --- Setelah npm start, sebagai admin: ---
# 1. Login ke aplikasi SIMORA sebagai user role admin
# 2. Buka http://localhost:3000/api/onedrive/connect di browser yang sama
# 3. Login pakai akun Microsoft pribadi (bpskka@gmail.com), klik Accept/Izinkan
# 4. Kalau muncul "OneDrive berhasil terhubung", selesai — tidak perlu diulang
#    kecuali file data/onedrive-token.json dihapus atau izin dicabut.
